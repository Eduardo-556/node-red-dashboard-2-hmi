    {
        "id": "env_cmd",
        "type": "function",
        "z": "ex_env",
        "name": "aplica comando",
        "func": "// Comandos da tela. Aqui só mudam a simulação; no seu flow ligue a saída no CLP.\nconst cmd = flow.get('cmd') || { rodando: 1 }\nconst on = Number(msg.payload) ? 1 : 0\nif (msg.topic === 'cmd/partir' && on) cmd.rodando = 1\nif (msg.topic === 'cmd/parar' && on) cmd.rodando = 0\nflow.set('cmd', cmd)\nreturn msg",
        "outputs": 1,
