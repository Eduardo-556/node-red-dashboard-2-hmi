 {
  "id": "hx_base",
  "type": "ui-base",
  "name": "Dashboard",
  "path": "/dashboard",
  "includeClientData": true,
  "acceptsClientConfig": [
   "ui-notification",
   "ui-control"
  ],
  "showPathInSidebar": false,
  "navigationStyle": "none",
  "titleBarStyle": "hidden"
 },
 {
  "id": "hx_theme",
  "type": "ui-theme",
  "name": "Default",
  "colors": {
   "surface": "#ffffff",
   "primary": "#0094CE",
   "bgPage": "#eeeeee",
   "groupBg": "#ffffff",
   "groupOutline": "#cccccc"
  },
  "sizes": {
   "pagePadding": "12px",
   "groupGap": "12px",
   "groupBorderRadius": "4px",
   "widgetGap": "12px"
  }
 },
