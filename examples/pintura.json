    {
        "id": "pin_sim",
        "type": "function",
        "z": "ex_pin",
        "name": "simula linha",
        "func": "// Simulação da linha de pintura. Troque pelos valores do seu CLP.\nconst s = flow.get('sim') || { pecas: 0, tintaA: 80, tintaB: 60, t: 0, temp: 150 }\nconst cmd = flow.get('cmd') || { esteira: 1 }\ns.t++\nconst ligada = cmd.esteira === 1 && !s.falha\nif (ligada && s.t % 3 === 0) s.pecas++\ns.tintaA = s.tintaA <= 8 ? 95 : s.tintaA - (ligada ? 0.6 : 0)\ns.tintaB = s.tintaB <= 5 ? 90 : s.tintaB - (ligada ? 0.4 : 0)\ns.temp += ((ligada ? 205 : 120) - s.temp) * 0.08 + (Math.random() - 0.5) * 3\n// de vez em quando a cabine entra em falha; o comando reset limpa\nif (!s.falha && Math.random() < 0.01) s.falha = true\nif (cmd.reset) { s.falha = false; cmd.reset = 0; flow.set('cmd', cmd) }\nflow.set('sim', s)\nconst r = v => Math.round(v * 10) / 10\nmsg.payload = {\n    lote: 'P' + (2610 + Math.floor(s.pecas / 50)), pecas: s.pecas, modo: 1,\n    esteira: ligada ? 1 : 0, falhaEsteira: 0, velocidade: ligada ? r(6 + Math.random()) : 0,\n    tempDesengraxe: r(62 + Math.random() * 4), aqDesengraxe: 1,\n    cabine: ligada ? 1 : 0, falhaCabine: s.falha ? 1 : 0, robo: ligada ? 1 : 0,\n    tempEstufa: r(s.temp), spEstufa: 200, queimador: s.temp < 200 ? 1 : 0, portaEstufa: 0,\n    resfriamento: ligada ? 1 : 0, pecaSaida: ligada && s.t % 3 === 0 ? 1 : 0,\n    tintaA: r(s.tintaA), tintaB: r(s.tintaB),\n    disp: 91.5, perf: r(86 + Math.random() * 4), qual: 98.2,\n    turno1: 412, turno2: 388, turno3: s.pecas,\n    tProduzindo: 410 + Math.floor(s.t / 60), tParada: 35, tSetup: 22\n}\nreturn msg",
        "outputs": 1,
        "x": 290,
        "y": 120,
        "wires": [
            [
                "pin_canvas"
            ]
        ]
    },
