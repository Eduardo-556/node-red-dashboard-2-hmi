    {
        "id": "est_sim",
        "type": "function",
        "z": "ex_est",
        "name": "simula esteiras",
        "func": "// Simulação das esteiras. Troque pelos valores do seu CLP.\nconst s = flow.get('sim') || { boas: 0, refugo: 0, t: 0, h: [0, 0, 0] }\nconst cmd = flow.get('cmd') || { rodando: 1, m1: 1, m2: 1, m3: 1, velocidade: 30 }\ns.t++\nconst roda = i => cmd.rodando === 1 && cmd['m' + i] === 1\nconst passa = roda(1) && roda(2) && roda(3) && s.t % 2 === 0\nif (passa) { if (Math.random() < 0.06) s.refugo++; else s.boas++ }\nfor (let i = 0; i < 3; i++) if (roda(i + 1)) s.h[i] += 60\nflow.set('sim', s)\nmsg.payload = {\n    boas: s.boas, refugo: s.refugo, meta: 900, velocidade: cmd.velocidade,\n    rodando: cmd.rodando, parada: cmd.rodando ? 0 : 1, falha: 0,\n    rod1: roda(1) ? 1 : 0, rod2: roda(2) ? 1 : 0, rod3: roda(3) ? 1 : 0,\n    falha1: 0, falha2: 0, falha3: 0, modo: 1,\n    sp1: passa ? 1 : 0, sp2: roda(2) && s.t % 2 === 1 ? 1 : 0, sp3: passa ? 1 : 0,\n    horas1: 3600 * 812 + s.h[0], horas2: 3600 * 640 + s.h[1], horas3: 3600 * 1203 + s.h[2],\n    desvio: Math.random() < 0.06 ? 1 : 0,\n    h1: 118, h2: 126, h3: 109, h4: 131, h5: 97, h6: Math.floor(s.boas / 2)\n}\nreturn msg",
        "outputs": 1,
        "x": 290,
        "y": 120,
        "wires": [
            [
                "est_canvas"
            ]
        ]
    },
