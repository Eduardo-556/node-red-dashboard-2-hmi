    {
        "id": "est_cmd",
        "type": "function",
        "z": "ex_est",
        "name": "aplica comando",
        "func": "// Comandos da tela. Aqui só mudam a simulação; no seu flow ligue a saída no CLP.\nconst cmd = flow.get('cmd') || { rodando: 1, m1: 1, m2: 1, m3: 1, velocidade: 30 }\nconst on = Number(msg.payload) ? 1 : 0\nif (msg.topic === 'cmd/partir' && on) cmd.rodando = 1\nif (msg.topic === 'cmd/parar' && on) cmd.rodando = 0\nif (msg.topic === 'cmd/velocidade') cmd.velocidade = Number(msg.payload)\nconst m = /^cmd\\/m(\\d)$/.exec(msg.topic || '')\nif (m) cmd['m' + m[1]] = on\nflow.set('cmd', cmd)\nreturn msg",
        "outputs": 1,
        "x": 660,
        "y": 120,
        "wires": [
            [
                "est_dbg"
            ]
        ]
    },
