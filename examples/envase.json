    {
        "id": "env_sim",
        "type": "function",
        "z": "ex_env",
        "name": "simula envase",
        "func": "// Ciclo de envase simulado. Troque pelos valores do seu CLP.\n// passos: 0 esteira leva a garrafa, 1 trava (cilindro) e enche, 2 tampa, 3 rotula, 4 solta\nconst s = flow.get('sim') || { passo: 0, t: 0, nivel: 0, garrafas: 0 }\nconst cmd = flow.get('cmd') || { rodando: 1 }\nif (cmd.rodando) {\n    s.t++\n    if (s.passo === 0 && s.t >= 3) { s.passo = 1; s.t = 0; s.nivel = 0 }\n    else if (s.passo === 1) { s.nivel = Math.min(100, s.nivel + 20); if (s.nivel >= 100) { s.passo = 2; s.t = 0 } }\n    else if (s.passo === 2 && s.t >= 2) { s.passo = 3; s.t = 0 }\n    else if (s.passo === 3 && s.t >= 2) { s.passo = 4; s.t = 0; s.garrafas++ }\n    else if (s.passo === 4 && s.t >= 1) { s.passo = 0; s.t = 0; s.nivel = 0 }\n}\nflow.set('sim', s)\nconst trava = s.passo >= 1 && s.passo <= 3\nmsg.payload = {\n    rodando: cmd.rodando, ciclo: s.passo,\n    'E1.esteira': cmd.rodando && (s.passo === 0 || s.passo === 4) ? 1 : 0,\n    'E1.garrafa': s.passo >= 1 && s.passo <= 3 ? 1 : 0,\n    'E1.nivel': s.nivel, 'E1.tampa': s.passo === 2 ? 1 : 0, 'E1.rotulo': s.passo === 3 ? 1 : 0,\n    'E1.garrafas': s.garrafas, 'E1.falha': cmd.rodando ? 0 : 1,\n    'Y1.solenoide': trava ? 1 : 0, 'Y1.avancado': trava ? 1 : 0, 'Y1.recuado': trava ? 0 : 1\n}\nreturn msg",
        "outputs": 1,
        "x": 290,
        "y": 120,
        "wires": [
            [
                "env_canvas"
            ]
        ]
    },
