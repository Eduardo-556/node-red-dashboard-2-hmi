    {
        "id": "clp_modbus",
        "type": "function",
        "z": "ex_clp",
        "name": "para Modbus",
        "func": "// Converte o comando da tela em escrita Modbus (formato do \"Modbus Flex Write\"\n// do node-red-contrib-modbus). Ajuste os endereços %MW do seu programa.\nconst map = { setpoint: 4, comando: 6 }\nconst address = map[msg.topic]\nif (address === undefined) return null\nmsg.payload = { value: Math.round(Number(msg.payload)), fc: 6, unitid: 1, address, quantity: 1 }\nreturn msg",
        "outputs": 1,
        "x": 620,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "clp_dbg",
