    {
        "id": "pin_cmd",
        "type": "function",
        "z": "ex_pin",
        "name": "aplica comando",
        "func": "// Comandos da tela (faceplate da esteira). Aqui só mudam a simulação;\n// no seu flow ligue a saída do canvas no nó de escrita do CLP.\nconst cmd = flow.get('cmd') || { esteira: 1 }\nif (msg.topic === 'cmd/esteira') cmd.esteira = Number(msg.payload) ? 1 : 0\nif (msg.topic === 'reset') cmd.reset = 1\nflow.set('cmd', cmd)\nreturn msg",
        "outputs": 1,
        "x": 660,
        "y": 120,
        "wires": [
