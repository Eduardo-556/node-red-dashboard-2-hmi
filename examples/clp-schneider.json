[
    {
        "id": "ex_clp",
        "type": "tab",
        "label": "IHM CLP Schneider",
        "info": "Lê um M221 com o schneider read e mostra no hmi canvas. Abra /dashboard/clp."
    },
    {
        "id": "hx_base",
        "type": "ui-base",
        "name": "Dashboard",
        "path": "/dashboard",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ],
        "showPathInSidebar": false,
        "navigationStyle": "none",
        "titleBarStyle": "hidden"
    },
    {
        "id": "hx_theme",
        "type": "ui-theme",
        "name": "Default",
        "colors": {
            "surface": "#ffffff",
            "primary": "#0094CE",
            "bgPage": "#eeeeee",
            "groupBg": "#ffffff",
            "groupOutline": "#cccccc"
        },
        "sizes": {
            "pagePadding": "12px",
            "groupGap": "12px",
            "groupBorderRadius": "4px",
            "widgetGap": "12px"
        }
    },
    {
        "id": "pg_clp",
        "type": "ui-page",
        "name": "CLP",
        "ui": "hx_base",
        "path": "/clp",
        "icon": "factory",
        "layout": "grid",
        "theme": "hx_theme",
        "breakpoints": [
            {
                "name": "Default",
                "px": "0",
                "cols": "3"
            },
            {
                "name": "Desktop",
                "px": "1024",
                "cols": "12"
            }
        ],
        "order": 4,
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "clp_cmt",
        "type": "comment",
        "z": "ex_clp",
        "name": "Precisa do node-red-contrib-schneider-modbus-tags. Ajuste o IP do CLP e a lista de tags.",
        "info": "As chaves do payload do schneider read são os nomes da lista de tags. Cada símbolo usa um desses nomes como chave.\n\nPara escrever no CLP, ligue a saída de \"para Modbus\" num nó Modbus Flex Write (node-red-contrib-modbus) apontando para o mesmo CLP.",
        "x": 330,
        "y": 40,
        "wires": []
    },
    {
        "id": "clp_plc",
        "type": "schneider-plc",
        "name": "M221",
        "model": "M221",
        "host": "192.168.1.10",
        "port": 502,
        "unitId": 1,
        "timeout": 3000,
        "reconnectDelay": 5000,
        "maxQuantity": 120
    },
    {
        "id": "clp_read",
        "type": "schneider-read",
        "z": "ex_clp",
        "name": "leitura",
        "plc": "clp_plc",
        "tags": "# Troque pelos endereços do seu programa\nMF0      temperatura\nMD2      contador_pecas\nMW4      setpoint\nMW5.0    motor_ligado\nMW5.1    falha_motor\nMW10     string[20] codigo_lote\nMF20     nivel_tanque",
        "interval": 1,
        "topic": "M221",
        "wordOrder": "low",
        "byteOrder": "low",
        "decimals": "3",
        "x": 140,
        "y": 120,
        "wires": [
            [
                "clp_canvas"
            ]
        ]
    },
    {
        "id": "clp_test",
        "type": "inject",
        "z": "ex_clp",
        "name": "valores de teste (sem CLP)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "once": false,
        "topic": "",
        "payload": "{\"temperatura\":72.4,\"contador_pecas\":1450,\"setpoint\":75,\"motor_ligado\":true,\"falha_motor\":false,\"codigo_lote\":\"L2026-1017\",\"nivel_tanque\":63.5}",
        "payloadType": "json",
        "x": 170,
        "y": 180,
        "wires": [
            [
                "clp_canvas"
            ]
        ]
    },
